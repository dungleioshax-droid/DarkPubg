<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>get-task-allow</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)*</string>
	</array>

	<!-- kernrw86: bộ entitlement để -espgui spawn root + host window + Metal
	     — cop đúng đường trình của TrollSpeed/Linhcute (/home/dungle/Troll
	     layout/entitlements.plist thực dụng). Khắc bổn posix_spawn rc=1 (EPERM)
	     trên DarkSword euid=0501 vì missing entitlements. -->

	<!-- Spawn process con (persona uid 0) -->
	<key>com.apple.private.persona-mgmt</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>platform-application</key>
	<true/>
	<key>file-read-data</key>
	<true/>
	<key>user-preference-read</key>
	<true/>
	<key>user-preference-write</key>
	<true/>

	<!-- Host cửa sổ hệ thống qua SBSAccessibilityWindowHosting - child overlay -->
	<key>com.apple.springboard.accessibility-window-hosting</key>
	<true/>
	<key>com.apple.springboard.CFUserNotification</key>
	<true/>
	<key>com.apple.backboard.client</key>
	<true/>
	<key>com.apple.QuartzCore.displayable-context</key>
	<true/>
	<key>com.apple.QuartzCore.secure-mode</key>
	<true/>
	<key>com.apple.private.allow-stacked-hc-layers</key>
	<true/>

	<!-- Metal / Render (subset của Linhcute) -->
	<key>com.apple.security.iokit-user-client-class</key>
	<array>
		<string>IOSurfaceRootUserClient</string>
		<string>AGXDeviceUserClient</string>
		<string>AGXSharedUserClient</string>
		<string>AGXCommandQueue</string>
	</array>
	<key>com.apple.private.allow-explicit-graphics-priority</key>
	<true/>
	<key>com.apple.developer.metal-device-observers</key>
	<true/>

	<!-- Đọc memory game: task_for_pid + task ports (ESPTask Route A) -->
	<key>task_for_pid-allow</key>
	<true/>
	<key>com.apple.system-task-ports</key>
	<true/>

	<!-- Giữ child overlay sống khi tiết kiệm memory -->
	<key>com.apple.private.kernel.jetsam</key>
	<true/>
	<key>com.apple.private.memorystatus</key>
	<true/>
</dict>
</plist>
